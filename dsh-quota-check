function readMem() {
  try {
    const m = JSON.parse(readFileSync(MEM, "utf8"));
    return m.day === today() ? m : { day: today(), dry: {} };
  } catch {
    return { day: today(), dry: {} };
  }
}
function writeMem(m) {
  mkdirSync(dirname(MEM), { recursive: true });
  writeFileSync(MEM, JSON.stringify({ ...m, day: today() }, null, 1));
}
/** 记忆里有没有这条（provider 级或 provider/model 级） */
function memDry(m, provider, model) {
  const a = m.dry[provider];
  const b = m.dry[`${provider}/${model}`];
  return b || a || null;
}

function getJson(url) {
  return new Promise((resolve, reject) => {
    import("node:http").then(({ get }) => {
      get(url, (res) => {
        let b = "";
        res.on("data", (c) => (b += c));
        res.on("end", () => { try { resolve(JSON.parse(b)); } catch (e) { reject(new Error("bad json")); } });
      }).on("error", reject);
    });
  });
}

function evaluate(snap) {
  const out = {};
  for (const it of snap.items || []) {
    const p = it.id;
    let state = "available", why = it.text || "";
    const notes = [];
    // 通用：插件捕获到厂商「额度/余额用尽」真实报错 → 直接判干涸（优先级最高）
    const realExhausted = it.exhausted === true;
    if (realExhausted) { state = "dry"; why = `厂商实测额度用尽：${it.exhaustedReason || it.text || ""}`; }
    if (p === "cloudflare-workers-ai") {
      if (typeof it.remaining === "number" && it.remaining <= 0) { state = "dry"; why = `neuron 额度已用尽（${it.text}）`; }
      else notes.push("按费率估算，非官方真实用量");
    } else if (p === "modelscope") {
      const m = /余额\s*(\d+(?:\.\d+)?)/.exec(it.note || "") || /(\d+(?:\.\d+)?)\s*魔粒/.exec(it.text || "");
      if (m && Number(m[1]) <= 0) { state = "dry"; why = "魔粒余额为 0"; }
      else if (!m) { state = "unknown"; why = "没有当天抄录的魔粒余额"; }
      else {
        const age = magicAgeMin();
        if (age !== null && age > 30) {
          state = "stale";
          why = `抄录值「${m[1]} 魔粒」是 ${age} 分钟前的，已不可信`;
        } else {
          notes.push(`余额 ${m[1]} 魔粒（抄录值${age !== null ? "，" + age + " 分钟前" : ""}）`);
        }
      }
    } else if (p === "openai") {
      const ws = it.windows || [];
      const worst = ws.length ? Math.min(...ws.map((w) => Number(w.remainingPercent ?? 100))) : 100;
      const tight = ws.find((w) => Number(w.remainingPercent ?? 100) === worst);
      if (worst <= 0) { state = "dry"; why = `套餐窗口「${tight?.name}」已用尽`; }
      else notes.push(`最紧窗口「${tight?.name}」剩 ${worst.toFixed(1)}%`);
    } else if (p === "deepseek-official") {
      if (typeof it.balance === "number" && it.balance <= 0.5) { state = "dry"; why = `余额仅 ¥${it.balance}`; }
    } else if (p === "sensenova") { state = "unknown"; why = "商汤官方无额度查询接口，读不到"; }
    else if (p === "aly") { if (typeof it.balance === "number" && it.balance <= 0.01) { state = "dry"; why = `余额仅 ¥${it.balance}`; } }
    // realExhausted 判干涸后，不要再被 provider 分支的 available/unknown 覆盖
    if (realExhausted) state = "dry";
    out[p] = { state, why, notes, label: it.label, exhausted: realExhausted, exhaustedReason: it.exhaustedReason };
  }
  return out;
}

const ICON = { available: "✅", dry: "⛔", stale: "⚠️", unknown: "❓" };
const argVal = (argv, k) => { const i = argv.indexOf(k); return i === -1 ? null : (argv[i + 1] ?? ""); };

async function main() {
  const argv = process.argv.slice(2);
  const mem = readMem();

  // ── 记忆写入类操作（不需要快照）──
  const dryRoute = argVal(argv, "--dry");
  if (dryRoute !== null && dryRoute !== "") {
    const reason = argv[argv.indexOf("--dry") + 2] || "手动标记";
    mem.dry[dryRoute] = { reason, at: Date.now() };
    writeMem(mem);
    console.log(`⛔ 已记下：${dryRoute} 今天不可用 — ${reason}`);
    console.log(`   记忆文件：${MEM}（day=${today()}，明天自动失效）`);
    return;
  }
  const undry = argVal(argv, "--undry");
  if (undry) {
    const had = mem.dry[undry];
    delete mem.dry[undry];
    writeMem(mem);
    console.log(had ? `✅ 已撤销：${undry}` : `（本来就没记：${undry}）`);
    return;
  }
  if (argv.includes("--clear")) {
    writeMem({ day: today(), dry: {} });
    console.log("✅ 已清空今天的干涸记忆");
    return;
  }

  let snap;
  try { snap = await getJson(URL); }
  catch (e) {
    console.error(`❌ 读不到额度快照（${URL}）：${e.message}`);
    console.error(`   → 确认 DSH 在运行、端口是 ${PORT}（可用 DSH_PORT=<port> 覆盖）`);
    process.exit(3);
  }
  if (argv.includes("--json")) { console.log(JSON.stringify(snap, null, 1)); return; }

  const byProv = evaluate(snap);
  // ⚠ 快照里没有的 provider（dsh-quota 插件不认识它们）默认会被判成 unknown，
  //   而 --pick 的排序是 available(0) < stale(1) < unknown(2) —— unknown 会被排到
  //   available 后面，**让 ROUTES 的表顺序失效**。这里显式声明「免费且无额度可查」的
  //   provider，让它们按 available 参与排序，表顺序才真正等于优先级。
  const FREE_UNTRACKED = {
    bigmodel: "免费 Flash 系持续可用、无额度概念（2026-09-28 实测 3 条全通）",
    hunyuan:
      "腾讯 TokenHub：新账号一次性免费 100 万 tokens（官方文档，用完转按量；用户已关付费 → 用完只会报错不会扣费）",
  };
  const res = (prov, model) => {
    let s = byProv[prov];
    if (!s) {
      const why = FREE_UNTRACKED[prov];
      s = why
        ? { state: "available", why, notes: [] }
        : { state: "unknown", why: "快照里没有这个 provider", notes: [] };
    }
    // 插件捕获到厂商「额度用尽」类真实报错 → 直接判干涸（比估算可信）
    if (s.state !== "dry" && s.exhausted === true) {
      return { state: "dry", why: `厂商实测：额度已用尽（${s.exhaustedReason || "真实报错"}）`, notes: s.notes };
    }
    const md = memDry(mem, prov, model);
    if (md) return { state: "dry", why: `今天已记干涸：${md.reason}`, notes: s.notes };
    return s;
  };

  const check = argVal(argv, "--check");
  if (check) {
    const i = check.indexOf("/");
    const prov = i === -1 ? check : check.slice(0, i);
    const model = i === -1 ? "*" : check.slice(i + 1);
    const st = res(prov, model);
    console.log(`${ICON[st.state]} ${prov}/${model}  ${st.state}  — ${st.why}`);
    process.exit(st.state === "available" ? 0 : st.state === "dry" ? 2 : 3);
  }

  const pick = argVal(argv, "--pick");
  if (pick) {
    if (!ROUTES[pick]) { console.error(`❌ 未知形状 ${pick}（可选 default|long|short|vision）`); process.exit(3); }
    const RANK = { available: 0, stale: 1, unknown: 2 };
    const cands = ROUTES[pick].map(([prov, model, name], i) => ({ prov, model, name, i, st: res(prov, model) }));
    for (const c of cands) {
      console.log(`${ICON[c.st.state]} ${c.st.state === "dry" ? "跳过" : "候选"} ${c.prov}/${c.model} — ${c.st.why}`);
    }
    const ok = cands.filter((c) => c.st.state !== "dry")
      .sort((a, b) => (RANK[a.st.state] ?? 3) - (RANK[b.st.state] ?? 3) || a.i - b.i);
    if (ok.length === 0) {
      console.log(`⛔ 【${pick}】里所有路由都不可用（免费+火山都干了）→ 只能上 deepseek-official 或等重置`);
      process.exit(2);
    }
    const w = ok[0];
    console.log();
    console.log(`${ICON[w.st.state]} 推荐【${pick}】→ ${w.prov}/${w.model}`);
    console.log(`   ${w.name}`);
    console.log(`   依据：${w.st.why || "额度正常"}${w.st.notes.length ? " · " + w.st.notes.join(" · ") : ""}`);
    if (w.st.state !== "available") console.log(`   ⚠ 这条不是「确定可用」（${w.st.state}）——失败就 --dry 它、再换下一条`);
    console.log(`   调用：subagent(..., provider: "${w.prov}", model: "${w.model}")`);
    process.exit(0);
  }

  console.log(`额度快照 · day=${snap.day} · 更新 ${new Date(snap.updatedAt).toLocaleString("zh-CN", { timeZone: "Asia/Shanghai" })}`);
  if (snap.warning) console.log(`⚠ ${snap.warning}`);
  const memN = Object.keys(mem.dry).length;
  console.log(`干涸记忆：${memN ? memN + " 条（" + Object.keys(mem.dry).join(", ") + "）" : "无"}`);
  // 快照里可能有「不在 --pick 阶梯里」的 provider：分两种标注，免得上当。
  const inRoutes = new Set(Object.values(ROUTES).flat().map(([p]) => p));
  // 白名单里有、但故意不进阶梯的（典型：hunyuan/TokenHub 计费未核实）
  const whitelistedButNotRouted = { hunyuan: "可显式指定，但 ⚠ 计费未核实，别当免费资源默认用" };
  console.log();
  for (const [prov, st] of Object.entries(byProv)) {
    const s = res(prov, "*");
    const tag = inRoutes.has(prov)
      ? ""
      : whitelistedButNotRouted[prov]
        ? `  ⚠ 不在任何 --pick 阶梯里（${whitelistedButNotRouted[prov]}）`
        : "  ⚠ 不在任何 --pick 阶梯里（也不在子代理白名单，显式选会被 Session 拒）";
    console.log(`${ICON[s.state]} ${String(prov).padEnd(22)} ${s.state.padEnd(10)} ${s.why}${tag}`);
    for (const n of s.notes) console.log(`      · ${n}`);
  }
  console.log();
  console.log("按任务形状挑：--pick default|long|short|vision    ／ 标记干涸：--dry <provider>/<model> [原因]");
}

main();
