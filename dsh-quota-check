/** 魔搭余额是「抄录值」，必须看抄录时间有多旧。返回分钟数，读不到返回 null。 */
function magicAgeMin() {
  try {
    const st = JSON.parse(readFileSync(DSH_HOME + "/storages/dsh-quota/state.json", "utf8"));
    const at = st?.magic?.at;
    return at ? Math.round((Date.now() - at) / 60000) : null;
  } catch { return null; }
}

